#!/usr/bin/env bash
# hi — central manager for Claude Code add-ons (rtk + caveman + superpowers)
# repos:
#   rtk         https://github.com/rtk-ai/rtk
#   caveman     https://github.com/JuliusBrussee/caveman
#   superpowers https://github.com/obra/superpowers

set -e

CAVEMAN_REPO="JuliusBrussee/caveman"
RTK_REPO="rtk-ai/rtk"
SUPERPOWERS_REPO="obra/superpowers"
SUPERPOWERS_MARKETPLACE="claude-plugins-official"
SUPERPOWERS_PLUGIN="superpowers@$SUPERPOWERS_MARKETPLACE"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CAVEMAN_FLAG="$CLAUDE_DIR/.caveman-active"
CAVEMAN_SUFFIX="$CLAUDE_DIR/.caveman-statusline-suffix"
CAVEMAN_HISTORY="$CLAUDE_DIR/.caveman-history.jsonl"
CLAUDE_PLUGINS_JSON="$CLAUDE_DIR/plugins/installed_plugins.json"

c_b=$'\e[1m'; c_dim=$'\e[2m'; c_g=$'\e[32m'; c_r=$'\e[31m'
c_y=$'\e[33m'; c_c=$'\e[36m'; c_rst=$'\e[0m'

ok()   { printf "  %s✓%s %s\n" "$c_g" "$c_rst" "$*"; }
bad()  { printf "  %s✗%s %s\n" "$c_r" "$c_rst" "$*"; }
warn() { printf "  %s!%s %s\n" "$c_y" "$c_rst" "$*"; }
info() { printf "  %s·%s %s\n" "$c_dim" "$c_rst" "$*"; }
head() { printf "\n%s%s%s\n" "$c_b" "$*" "$c_rst"; }
sub()  { printf "\n%s%s%s\n" "$c_c" "$*" "$c_rst"; }

have() { command -v "$1" >/dev/null 2>&1; }

# confirm "prompt" — interactive y/N (default yes). Returns 1 if non-tty so
# automation never blocks. Must be used inside `if`/`||`/`&&` because set -e.
confirm() {
  local prompt="${1:-Continue}" ans
  [ -t 0 ] && [ -t 1 ] || return 1
  printf "  %s? [Y/n] " "$prompt"
  read -r ans || return 1
  case "$ans" in ""|y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# ─── rtk ────────────────────────────────────────────────────────────────
rtk_installed() { command -v rtk >/dev/null 2>&1; }

# ─── caveman ────────────────────────────────────────────────────────────
caveman_hooks_installed() {
  [[ -d "$CLAUDE_DIR/hooks" ]] && ls "$CLAUDE_DIR/hooks"/caveman-* >/dev/null 2>&1
}
caveman_active_mode() {
  [[ -f "$CAVEMAN_FLAG" ]] && cat "$CAVEMAN_FLAG"
}

# ─── superpowers ────────────────────────────────────────────────────────
# Source of truth: Claude Code's installed_plugins.json. We grep/jq it
# directly rather than parsing `claude plugin list` to keep this fast and
# usable even when `claude` is not on PATH.
superpowers_installed() {
  [[ -f "$CLAUDE_PLUGINS_JSON" ]] || return 1
  if have jq; then
    jq -e --arg p "$SUPERPOWERS_PLUGIN" '.plugins[$p]' "$CLAUDE_PLUGINS_JSON" >/dev/null 2>&1
  else
    grep -q "\"$SUPERPOWERS_PLUGIN\"" "$CLAUDE_PLUGINS_JSON"
  fi
}

# ─── commands ───────────────────────────────────────────────────────────
cmd_status() {
  head "hi status"

  local missing=()

  sub "rtk  (Rust Token Killer)"
  if rtk_installed; then
    ok "installed at $(command -v rtk)"
    local v
    v=$(rtk --version 2>/dev/null || echo "(version unknown)")
    info "$v"
  else
    bad "not installed"
    info "run:  hi install rtk"
    if have brew;  then info "  ↳ best method here: brew install rtk"
    elif have curl; then info "  ↳ best method here: curl install.sh"
    elif have cargo; then info "  ↳ best method here: cargo install --git"
    fi
    info "manual: https://github.com/$RTK_REPO#installation"
    missing+=(rtk)
  fi

  sub "caveman"
  if caveman_hooks_installed; then
    ok "hooks present in $CLAUDE_DIR/hooks"
  else
    bad "hooks missing"
    info "run:  hi install caveman"
    missing+=(caveman)
  fi
  local m
  m=$(caveman_active_mode || true)
  if [[ -n "$m" ]]; then
    ok "active mode: ${c_b}$m${c_rst}"
  else
    warn "inactive (no flag file)"
  fi
  if [[ -f "$CAVEMAN_SUFFIX" ]]; then
    info "lifetime savings: $(cat "$CAVEMAN_SUFFIX")"
  fi

  sub "superpowers  (obra/superpowers)"
  if superpowers_installed; then
    ok "installed: $SUPERPOWERS_PLUGIN"
  else
    bad "not installed"
    info "run:  hi install superpowers"
    if ! have claude; then
      info "  ↳ claude CLI missing — fallback: /plugin install $SUPERPOWERS_PLUGIN inside Claude Code"
    fi
    missing+=(superpowers)
  fi
  echo

  # Interactive guide: if anything is missing and we're attached to a tty,
  # offer to install now. Skipped silently in pipes / CI.
  if (( ${#missing[@]} > 0 )); then
    sub "missing: ${missing[*]}"
    if confirm "install now"; then
      if (( ${#missing[@]} == 3 )); then
        cmd_install all
      else
        local m
        for m in "${missing[@]}"; do cmd_install "$m"; done
      fi
    else
      info "later: hi install ${missing[*]}"
      echo
    fi
  fi
}

# ─── installers ─────────────────────────────────────────────────────────
# rtk install method priority on macOS/Linux: brew > curl install.sh > cargo.
# NOTE: `cargo install rtk` (no --git) pulls the wrong crate (Rust Type Kit).
install_rtk() {
  head "install rtk"
  if rtk_installed; then
    ok "already installed: $(command -v rtk)"
    info "$(rtk --version 2>/dev/null || echo '(version unknown)')"
    return 0
  fi

  local method=""
  if have brew;  then method=brew
  elif have curl; then method=curl
  elif have cargo; then method=cargo
  else
    bad "no installer available — need one of: brew, curl, cargo"
    info "manual: https://github.com/$RTK_REPO#installation"
    return 1
  fi

  case "$method" in
    brew)
      info "method: brew install rtk"
      confirm "proceed" || { warn "skipped (other methods: curl, cargo)"; return 1; }
      brew install rtk
      ;;
    curl)
      info "method: curl install.sh | sh   (installs to ~/.local/bin)"
      confirm "proceed" || { warn "skipped"; return 1; }
      curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh
      ;;
    cargo)
      info "method: cargo install --git https://github.com/$RTK_REPO"
      info "(note: plain 'cargo install rtk' fetches the wrong crate)"
      confirm "proceed" || { warn "skipped"; return 1; }
      cargo install --git "https://github.com/$RTK_REPO"
      ;;
  esac

  hash -r 2>/dev/null || true
  if rtk_installed; then
    ok "installed: $(rtk --version 2>/dev/null || echo rtk)"
  else
    bad "install ran but rtk not found on PATH"
    case "$method" in
      curl)  info "add to PATH:  export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
      cargo) info "add to PATH:  export PATH=\"\$HOME/.cargo/bin:\$PATH\"" ;;
    esac
    return 1
  fi
}

install_caveman() {
  head "install caveman"
  if caveman_hooks_installed; then
    ok "hooks already present in $CLAUDE_DIR/hooks"
    confirm "reinstall anyway" || { info "skipping"; return 0; }
  fi
  if ! have node; then
    bad "node not on PATH — caveman needs Node ≥18"
    info "install Node first (brew install node, nvm, etc.)"
    return 1
  fi
  local maj
  maj=$(node -v | sed 's/v//' | cut -d. -f1)
  if (( maj < 18 )); then
    bad "node $(node -v) too old — caveman needs ≥18"
    return 1
  fi
  info "method: npx -y github:$CAVEMAN_REPO -- --non-interactive"
  confirm "proceed" || { warn "skipped"; return 1; }
  npx -y "github:$CAVEMAN_REPO" -- --non-interactive
  if caveman_hooks_installed; then
    ok "caveman hooks installed"
  else
    bad "install ran but hooks not found in $CLAUDE_DIR/hooks"
    return 1
  fi
}

install_superpowers() {
  head "install superpowers"
  if superpowers_installed; then
    ok "already installed: $SUPERPOWERS_PLUGIN"
    return 0
  fi
  if ! have claude; then
    bad "claude CLI not on PATH — can't auto-install"
    info "manual: open Claude Code, type:  /plugin install $SUPERPOWERS_PLUGIN"
    info "repo:   https://github.com/$SUPERPOWERS_REPO"
    return 1
  fi
  info "method: claude plugin install $SUPERPOWERS_PLUGIN"
  confirm "proceed" || { warn "skipped"; return 1; }

  # Marketplace may not be registered yet on a fresh machine.
  if ! claude plugin marketplace list 2>/dev/null | grep -q "$SUPERPOWERS_MARKETPLACE"; then
    info "registering marketplace anthropics/$SUPERPOWERS_MARKETPLACE"
    if ! claude plugin marketplace add "anthropics/$SUPERPOWERS_MARKETPLACE"; then
      bad "could not register marketplace"
      return 1
    fi
  fi

  claude plugin install "$SUPERPOWERS_PLUGIN"
  if superpowers_installed; then
    ok "installed: $SUPERPOWERS_PLUGIN"
    info "restart Claude Code session for plugin to fully load"
  else
    bad "install ran but $SUPERPOWERS_PLUGIN not present in installed_plugins.json"
    return 1
  fi
}

cmd_install() {
  case "${1:-all}" in
    rtk)         install_rtk ;;
    caveman)     install_caveman ;;
    superpowers) install_superpowers ;;
    all)
      local rc_c=0 rc_r=0 rc_s=0
      install_caveman     || rc_c=$?
      install_rtk         || rc_r=$?
      install_superpowers || rc_s=$?
      head "summary"
      (( rc_c == 0 )) && ok "caveman:     ok" || warn "caveman:     not installed"
      (( rc_r == 0 )) && ok "rtk:         ok" || warn "rtk:         not installed"
      (( rc_s == 0 )) && ok "superpowers: ok" || warn "superpowers: not installed"
      echo
      ;;
    *) echo "usage: hi install [rtk|caveman|superpowers|all]"; exit 1 ;;
  esac
}

cmd_uninstall() {
  case "${1:-}" in
    caveman)
      head "uninstall caveman"
      npx -y "github:$CAVEMAN_REPO" -- --uninstall
      ;;
    rtk)
      head "uninstall rtk"
      info "rtk has its own uninstall path — see https://github.com/$RTK_REPO"
      ;;
    all) "$0" uninstall caveman ;;
    *)   echo "usage: hi uninstall [rtk|caveman|all]"; exit 1 ;;
  esac
}

cmd_mode() {
  local m="${1:-}"
  case "$m" in
    lite|full|ultra|wenyan|wenyan-lite|wenyan-full|wenyan-ultra)
      mkdir -p "$(dirname "$CAVEMAN_FLAG")"
      printf '%s' "$m" > "$CAVEMAN_FLAG"
      ok "caveman mode → $m"
      info "applies to new Claude Code sessions (and any agent reading flag)"
      ;;
    off|disable|stop)
      rm -f "$CAVEMAN_FLAG"
      ok "caveman flag removed"
      ;;
    "")
      local cur
      cur=$(caveman_active_mode || echo "(off)")
      info "current: $cur"
      echo "usage: hi mode [lite|full|ultra|wenyan|wenyan-lite|wenyan-full|wenyan-ultra|off]"
      ;;
    *) echo "unknown mode: $m"; exit 1 ;;
  esac
}

cmd_stats() {
  head "hi stats"

  sub "rtk gain"
  if rtk_installed; then
    rtk gain 2>&1 || warn "rtk gain failed"
  else
    bad "rtk not installed"
  fi

  sub "caveman"
  if [[ ! -f "$CAVEMAN_HISTORY" ]]; then
    bad "no history yet — open Claude Code with caveman active"
    echo
    return
  fi
  if ! command -v node >/dev/null 2>&1; then
    bad "node not on PATH"
    echo
    return
  fi

  CAVEMAN_HISTORY="$CAVEMAN_HISTORY" node <<'NODE_EOF'
const fs = require('fs');
const path = process.env.CAVEMAN_HISTORY;
const lines = fs.readFileSync(path, 'utf8').split('\n').filter(Boolean);
const records = lines.map(l => { try { return JSON.parse(l); } catch { return null; }}).filter(Boolean);

if (records.length === 0) {
  console.log('  (history file empty)');
  process.exit(0);
}

// Latest record per session_id (history appends multiple snapshots per session)
const bySession = new Map();
for (const r of records) {
  const prev = bySession.get(r.session_id);
  if (!prev || r.ts > prev.ts) bySession.set(r.session_id, r);
}
const sessions = [...bySession.values()];

const totals = sessions.reduce((acc, r) => {
  acc.output += r.output_tokens || 0;
  acc.saved  += r.est_saved_tokens || 0;
  acc.usd    += r.est_saved_usd || 0;
  return acc;
}, { output: 0, saved: 0, usd: 0 });

// Per-mode aggregation
const byMode = new Map();
for (const r of sessions) {
  const m = r.mode || 'unknown';
  const cur = byMode.get(m) || { sessions: 0, output: 0, saved: 0, usd: 0 };
  cur.sessions += 1;
  cur.output += r.output_tokens || 0;
  cur.saved  += r.est_saved_tokens || 0;
  cur.usd    += r.est_saved_usd || 0;
  byMode.set(m, cur);
}

const k = n => n >= 1e6 ? (n/1e6).toFixed(1)+'M' : n >= 1e3 ? (n/1e3).toFixed(1)+'K' : String(n);
const pct = (s, o) => o > 0 ? (s/o*100) : 0;
const bar = (p, w=24) => { const f = Math.round(p/100*w); return '█'.repeat(f) + '░'.repeat(w-f); };

const C = (c,s) => `\x1b[${c}m${s}\x1b[0m`;
const dim = s => C('2', s);
const b   = s => C('1', s);

const totalPct = pct(totals.saved, totals.output);

console.log('');
console.log('Caveman Token Savings (lifetime)');
console.log('═'.repeat(60));
console.log('');
console.log(`Sessions:          ${sessions.length}`);
console.log(`Output tokens:     ${k(totals.output)}`);
console.log(`Tokens saved:      ${k(totals.saved)} (${totalPct.toFixed(1)}%)`);
console.log(`Est. cost saved:   $${totals.usd.toFixed(4)}`);
console.log(`Efficiency meter:  ${bar(totalPct)} ${totalPct.toFixed(1)}%`);
console.log('');
console.log('By Mode');
console.log('─'.repeat(67));
console.log('  Mode           Sessions  Output    Saved    Avg%    Impact');
console.log('─'.repeat(67));

const sorted = [...byMode.entries()].sort((a,b) => b[1].saved - a[1].saved);
for (const [mode, s] of sorted) {
  const p = pct(s.saved, s.output);
  const row = [
    `  ${mode.padEnd(13)}`,
    String(s.sessions).padStart(8),
    `  ${k(s.output).padStart(7)}`,
    `  ${k(s.saved).padStart(6)}`,
    `  ${p.toFixed(1).padStart(4)}%`,
    `  ${bar(p, 10)}`,
  ].join('');
  console.log(row);
}
console.log('─'.repeat(67));

if (totals.saved === 0) {
  console.log('');
  console.log(dim('  note: lite/ultra/wenyan have no benchmark coefficient yet;'));
  console.log(dim('  only `full` mode produces non-zero savings estimates.'));
  console.log(dim('  switch via: hi mode full'));
}
console.log('');
NODE_EOF

  if [[ -s "$CAVEMAN_SUFFIX" ]]; then
    info "statusline suffix: $(cat "$CAVEMAN_SUFFIX")"
  fi
  echo
}

cmd_update() {
  head "update caveman"
  npx -y "github:$CAVEMAN_REPO" -- --force --non-interactive

  head "update rtk"
  if rtk_installed; then
    info "rtk updates via its own channel — see https://github.com/$RTK_REPO"
  else
    bad "rtk not installed"
  fi
}

cmd_doctor() {
  cmd_status
  head "doctor"

  if command -v node >/dev/null 2>&1; then
    local maj
    maj=$(node -v | sed 's/v//' | cut -d. -f1)
    if (( maj >= 18 )); then ok "node $(node -v) (caveman needs ≥18)"
    else bad "node $(node -v) < 18 — caveman install will fail"; fi
  else
    bad "node not on PATH"
  fi

  local sj="$CLAUDE_DIR/settings.json"
  if [[ -f "$sj" ]]; then
    if node -e "JSON.parse(require('fs').readFileSync('$sj','utf8'))" 2>/dev/null; then
      ok "$sj parses as strict JSON"
    else
      warn "$sj has JSONC (comments/trailing commas) — caveman handles, others may not"
    fi
  else
    warn "no $sj yet"
  fi

  if command -v claude >/dev/null 2>&1; then
    ok "claude CLI present"
  else
    warn "claude CLI not on PATH — Claude Code commands won't work from terminal"
  fi
  echo
}

cmd_proxy() {
  case "${1:-show}" in
    show|status|"")
      head "proxy"
      if [[ -n "${https_proxy:-}${http_proxy:-}${all_proxy:-}" ]]; then
        ok "active"
        [[ -n "${https_proxy:-}" ]] && info "https_proxy = $https_proxy"
        [[ -n "${http_proxy:-}"  ]] && info "http_proxy  = $http_proxy"
        [[ -n "${all_proxy:-}"   ]] && info "all_proxy   = $all_proxy"
      else
        warn "no proxy set in current env"
      fi
      ;;
    *)
      bad "set/unset must run in your shell (subprocess can't mutate parent env)"
      info "use the zsh wrapper: hi proxy <port|off>"
      info "or eval: eval \"\$(<port emit logic>)\""
      exit 1
      ;;
  esac
}

usage() {
  cat <<EOF
${c_b}hi${c_rst} — central manager for Claude Code add-ons (rtk + caveman + superpowers)

usage:
  hi status                health + active mode for all managed tools
  hi setup                 first-run alias for: hi install all
  hi install [tool|all]    install with auto-detected method + [Y/n] confirm
                            rtk: brew > curl install.sh > cargo install --git
                            caveman: npx (needs Node ≥18)
                            superpowers: claude plugin install (needs claude CLI)
  hi uninstall [tool|all]  uninstall
  hi mode <lvl|off>        caveman mode: lite|full|ultra|wenyan|wenyan-*|off
  hi stats                 combined token-savings report
  hi proxy <port|off|show> http(s)_proxy + all_proxy → 127.0.0.1:<port>
                            (needs zsh wrapper in .zshrc to mutate env)
  hi update                update caveman to latest from main
  hi doctor                deep health check (node, settings.json, claude CLI)
  hi help                  this message

repos:
  caveman      https://github.com/$CAVEMAN_REPO
  rtk          https://github.com/$RTK_REPO
  superpowers  https://github.com/$SUPERPOWERS_REPO
EOF
}

case "${1:-status}" in
  status)         shift || true; cmd_status "$@" ;;
  setup)          shift || true; cmd_install all ;;
  install)        shift; cmd_install "$@" ;;
  uninstall|rm)   shift; cmd_uninstall "$@" ;;
  mode)           shift; cmd_mode "$@" ;;
  stats)          shift || true; cmd_stats "$@" ;;
  proxy)          shift; cmd_proxy "$@" ;;
  update|upgrade) shift || true; cmd_update "$@" ;;
  doctor|check)   shift || true; cmd_doctor "$@" ;;
  help|-h|--help) usage ;;
  *)              usage; exit 1 ;;
esac
